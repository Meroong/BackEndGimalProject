<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>모임 상세 - 관리자</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin.css">

    <style>
        .meeting-layout {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* 상단 요약 카드 */
        .meeting-summary-card {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 20px 22px;
            border-radius: 20px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
        }
        .meeting-title-box {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .meeting-title-main {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
        }
        .meeting-title-sub {
            font-size: 13px;
            color: #6b7280;
        }

        .meeting-meta-row {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-open {
            background: #dcfce7;
            color: #166534;
        }
        .status-closed {
            background: #fef3c7;
            color: #92400e;
        }
        .status-completed {
            background: #e5e7eb;
            color: #374151;
        }
        .tag-pill {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            background: #e0f2fe;
            color: #0369a1;
            font-size: 11px;
            font-weight: 600;
        }

        /* 정보 그리드 */
        .info-card {
            padding: 18px 20px;
            border-radius: 18px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
        }
        .info-card-title {
            font-size: 15px;
            font-weight: 600;
            color: #111827;
            margin-bottom: 10px;
        }
        .info-card-desc {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 12px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px 20px;
            margin-top: 4px;
        }

        .info-label {
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: 2px;
        }

        .info-value {
            font-size: 14px;
            color: #111827;
        }

        /* 상태 변경 */
        .status-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .status-select {
            min-width: 220px;
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid #d1d5db;
            font-size: 14px;
            background-color: #fff;
        }

        /* 내용 카드 */
        .meeting-content-box {
            margin-top: 8px;
            padding: 18px 20px;
            border-radius: 18px;
            background: #f9fafb;
            font-size: 14px;
            color: #4b5563;
            line-height: 1.6;
            white-space: pre-line;
            border: 1px solid #e5e7eb;
        }

        .section-divider {
            margin: 24px 0 12px;
            border: none;
            border-top: 1px solid #e5e7eb;
        }
    </style>
</head>
<body class="admin-body">

<div class="admin-container">

    <!-- 상단 헤더 -->
    <header>
        <h1>모임 상세</h1>

        <div class="header-buttons">
            <button class="log-btn"
                    onclick="location.href='${pageContext.request.contextPath}/admin/meeting/list'">
                목록으로
            </button>
        </div>
    </header>

    <!-- 메인 박스 -->
    <section class="main-box meeting-layout">

        <!-- 🔹 상단 요약 카드 -->
        <div class="meeting-summary-card">
            <div class="meeting-title-box">
                <div class="meeting-title-main">
                    <c:out value="${meeting.title}"/>
                </div>
                <div class="meeting-title-sub">
                    모임 번호 #<c:out value="${meeting.id}"/> ·
                    생성일
                    <fmt:formatDate value="${meeting.createdAt}" pattern="yyyy-MM-dd HH:mm"/>
                </div>
            </div>

            <div class="meeting-meta-row">
                <!-- 상태 배지 -->
                <div>
                    <c:choose>
                        <c:when test="${meeting.status == 'OPEN'}">
                            <span class="status-badge status-open">OPEN (모집중)</span>
                        </c:when>
                        <c:when test="${meeting.status == 'CLOSED'}">
                            <span class="status-badge status-closed">CLOSED (모집 마감)</span>
                        </c:when>
                        <c:when test="${meeting.status == 'COMPLETED'}">
                            <span class="status-badge status-completed">COMPLETED (모임 종료)</span>
                        </c:when>
                        <c:otherwise>
                            <span class="status-badge">
                                <c:out value="${meeting.status}"/>
                            </span>
                        </c:otherwise>
                    </c:choose>
                </div>

                <!-- 태그 -->
                <c:if test="${not empty meeting.tag}">
                    <div>
                        <span class="tag-pill">#<c:out value="${meeting.tag}"/></span>
                    </div>
                </c:if>
            </div>
        </div>

        <!-- 🔹 모임 기본 정보 카드 -->
        <div class="info-card">
            <div class="info-card-title">모임 정보</div>
            <p class="info-card-desc">
                모임 일정, 인원, 참가비 등의 기본 정보를 확인할 수 있습니다.
            </p>

            <div class="info-grid">
                <!-- 일정 -->
                <div>
                    <div class="info-label">모임 일시</div>
                    <div class="info-value">
                        <fmt:formatDate value="${meeting.date}" pattern="yyyy-MM-dd HH:mm"/>
                    </div>
                </div>

                <!-- 인원 -->
                <div>
                    <div class="info-label">모집 인원</div>
                    <div class="info-value">
                        <c:out value="${meeting.currentMembers}"/> /
                        <c:out value="${meeting.maxMembers}"/> 명
                    </div>
                </div>

                <!-- 참가비 -->
                <div>
                    <div class="info-label">참가비</div>
                    <div class="info-value">
                        <c:out value="${meeting.cost}"/> 원
                    </div>
                </div>

                <!-- 생성일 -->
                <div>
                    <div class="info-label">생성일</div>
                    <div class="info-value">
                        <fmt:formatDate value="${meeting.createdAt}" pattern="yyyy-MM-dd HH:mm"/>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🔹 상태 변경 카드 -->
        <div class="info-card">
            <div class="info-card-title">상태 변경</div>
            <p class="info-card-desc">
                모임의 상태를 변경하면 즉시 DB에 반영되며, 모임 목록 화면에도 동일하게 표시됩니다.
            </p>

            <div class="status-row">
                <form method="post"
                      action="${pageContext.request.contextPath}/admin/meeting/status"
                      style="display:inline-flex; align-items:center; gap:10px; flex-wrap:wrap;">

                    <!-- 어떤 모임인지 넘겨주기 -->
                    <input type="hidden" name="id" value="${meeting.id}"/>

                    <select name="status" class="status-select">
                        <option value="OPEN"
                            <c:if test="${meeting.status == 'OPEN'}">selected</c:if>>
                            OPEN (모집중)
                        </option>
                        <option value="CLOSED"
                            <c:if test="${meeting.status == 'CLOSED'}">selected</c:if>>
                            CLOSED (모집 마감)
                        </option>
                        <option value="COMPLETED"
                            <c:if test="${meeting.status == 'COMPLETED'}">selected</c:if>>
                            COMPLETED (모임 종료)
                        </option>
                    </select>

                    <button type="submit" class="log-btn">
                        상태 변경
                    </button>
                </form>
            </div>
        </div>

        <!-- 🔹 모임 소개 카드 -->
        <div>
            <hr class="section-divider">

            <div class="info-label" style="margin-bottom: 6px;">모임 소개</div>
            <div class="meeting-content-box">
                <c:out value="${meeting.content}"/>
            </div>
        </div>

    </section>

</div>

</body>
</html>
