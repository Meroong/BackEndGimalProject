<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>모임 상세 - 관리자</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin.css">

    <style>
        .meeting-layout {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 120px 1fr;
            row-gap: 12px;
            column-gap: 24px;
            margin-top: 16px;
        }

        .info-label {
            font-weight: 600;
            color: #4b5563;
            font-size: 14px;
        }

        .info-value {
            font-size: 14px;
            color: #111827;
        }

        .info-muted {
            font-size: 13px;
            color: #6b7280;
        }

        .status-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 8px;
            flex-wrap: wrap;
        }

        .status-select {
            min-width: 220px;
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid #d1d5db;
            font-size: 14px;
            background-color: #fff;
        }

        .section-divider {
            margin: 28px 0 16px;
            border: none;
            border-top: 1px solid #e5e7eb;
        }

        .meeting-content-box {
            margin-top: 8px;
            padding: 16px 18px;
            border-radius: 16px;
            background: #f9fafb;
            font-size: 14px;
            color: #4b5563;
            line-height: 1.5;
            white-space: pre-line;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-open {
            background: #dcfce7;
            color: #166534;
        }
        .status-closed {
            background: #fef3c7;
            color: #92400e;
        }
        .status-completed {
            background: #e5e7eb;
            color: #374151;
        }
    </style>
</head>
<body class="admin-body">

<div class="admin-container">

    <!-- 상단 헤더 -->
    <header>
        <h1>모임 상세</h1>

        <div class="header-buttons">
            <button class="log-btn"
                    onclick="location.href='${pageContext.request.contextPath}/admin/meeting/list'">
                목록으로
            </button>
        </div>
    </header>

    <!-- 메인 박스 -->
    <section class="main-box meeting-layout">
        <!-- 모임 기본 정보 -->
        <div>
            <div class="box-title">모임 정보</div>
            <p class="info-muted">
                모임 상태를 포함한 기본 정보를 확인하고, 필요 시 상태를 변경할 수 있습니다.
            </p>

            <div class="info-grid">
                <!-- 번호 -->
                <div class="info-label">번호</div>
                <div class="info-value">
                    #<c:out value="${meeting.id}"/>
                </div>

                <!-- 제목 -->
                <div class="info-label">제목</div>
                <div class="info-value">
                    <c:out value="${meeting.title}"/>
                </div>

                <!-- 태그 -->
                <div class="info-label">태그</div>
                <div class="info-value">
                    <c:out value="${meeting.tag}"/>
                </div>

                <!-- 일정 (원본 date 그대로 출력) -->
                <div class="info-label">모임 일시</div>
                <div class="info-value">
                    <c:out value="${meeting.date}"/>
                </div>

                <!-- 인원 -->
                <div class="info-label">인원</div>
                <div class="info-value">
                    <c:out value="${meeting.currentMembers}"/> /
                    <c:out value="${meeting.maxMembers}"/> 명
                </div>

                <!-- 비용 -->
                <div class="info-label">참가비</div>
                <div class="info-value">
                    <c:out value="${meeting.cost}"/> 원
                </div>

                <!-- 생성일 -->
                <div class="info-label">생성일</div>
                <div class="info-value">
                    <c:out value="${meeting.createdAt}"/>
                </div>

                <!-- 현재 상태 -->
                <div class="info-label">현재 상태</div>
                <div class="info-value">
                    <c:choose>
                        <c:when test="${meeting.status == 'OPEN'}">
                            <span class="status-badge status-open">OPEN (모집중)</span>
                        </c:when>
                        <c:when test="${meeting.status == 'CLOSED'}">
                            <span class="status-badge status-closed">CLOSED (모집 마감)</span>
                        </c:when>
                        <c:when test="${meeting.status == 'COMPLETED'}">
                            <span class="status-badge status-completed">COMPLETED (모임 종료)</span>
                        </c:when>
                        <c:otherwise>
                            <span class="status-badge">
                                <c:out value="${meeting.status}"/>
                            </span>
                        </c:otherwise>
                    </c:choose>
                </div>
            </div>
        </div>

        <!-- 상태 변경 영역 -->
        <div>
            <hr class="section-divider">

            <div class="info-label" style="margin-bottom: 6px;">상태 변경</div>
            <p class="info-muted" style="margin-bottom: 8px;">
                상태를 변경하면 즉시 DB에 반영되며, 모임 목록에도 같은 상태로 표시됩니다.
            </p>

            <div class="status-row">
                <form method="post"
                      action="${pageContext.request.contextPath}/admin/meeting/status"
                      style="display:inline-flex; align-items:center; gap:10px; flex-wrap:wrap;">

                    <!-- 어떤 모임인지 넘겨주기 -->
                    <input type="hidden" name="id" value="${meeting.id}"/>

                    <select name="status" class="status-select">
                        <option value="OPEN"
                            <c:if test="${meeting.status == 'OPEN'}">selected</c:if>>
                            OPEN (모집중)
                        </option>
                        <option value="CLOSED"
                            <c:if test="${meeting.status == 'CLOSED'}">selected</c:if>>
                            CLOSED (모집 마감)
                        </option>
                        <option value="COMPLETED"
                            <c:if test="${meeting.status == 'COMPLETED'}">selected</c:if>>
                            COMPLETED (모임 종료)
                        </option>
                    </select>

                    <button type="submit" class="log-btn">
                        상태 변경
                    </button>
                </form>
            </div>
        </div>

        <!-- 모임 내용 -->
        <div>
            <hr class="section-divider">

            <div class="info-label" style="margin-bottom: 6px;">모임 소개</div>
            <div class="meeting-content-box">
                <c:out value="${meeting.content}"/>
            </div>
        </div>

    </section>

</div>

</body>
</html>
