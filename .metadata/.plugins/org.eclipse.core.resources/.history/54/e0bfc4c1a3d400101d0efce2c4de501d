<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>도란도란 - 서비스 통계</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin.css">

    <style>
        /* 상단 요약 카드 영역 */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }
        .stat-card {
            padding: 20px;
            border-radius: 18px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
            background: #ffffff;
        }
        .stat-title {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 6px;
        }
        .stat-value {
            font-size: 26px;
            font-weight: 700;
            color: #111827;
        }
        .stat-desc {
            margin-top: 4px;
            font-size: 12px;
            color: #9ca3af;
        }

        /* 섹션 제목 */
        .section-title {
            font-size: 18px;
            font-weight: 600;
            margin-top: 32px;
            margin-bottom: 8px;
        }
        .section-sub {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 12px;
        }

        /* 표 스타일 */
        .stats-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 18px rgba(0,0,0,0.06);
        }
        .stats-table th,
        .stats-table td {
            padding: 10px 12px;
            font-size: 13px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }
        .stats-table th {
            background: #f9fafb;
            font-weight: 600;
            color: #374151;
        }
        .stats-table tr:last-child td {
            border-bottom: none;
        }
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 11px;
        }
        .badge-pending {
            background: #fef3c7;
            color: #92400e;
        }
        .badge-resolved {
            background: #dcfce7;
            color: #166534;
        }
    </style>
</head>
<body class="admin-body">

<div class="admin-container">

    <!-- 상단 헤더 -->
    <header>
        <h1>서비스 통계</h1>

        <div class="header-buttons">
            <button class="log-btn"
                    onclick="location.href='${pageContext.request.contextPath}/'">
                홈으로
            </button>
            <button class="log-btn"
                    onclick="location.href='${pageContext.request.contextPath}/admin'">
                관리자 메인
            </button>
        </div>
    </header>

    <!-- 메인 박스 -->
    <section class="main-box">
        <div class="box-title">도란도란 운영 현황 한눈에 보기</div>
        <p>
            회원 증가 추이, 거래 활동, 신고 처리 현황을 한 번에 확인할 수 있는 관리자 전용 대시보드입니다.
        </p>

        <!-- 상단 요약 카드 -->
        <div class="stats-grid">

            <!-- 총 회원 수 -->
            <div class="stat-card">
                <div class="stat-title">총 회원 수</div>
                <div class="stat-value">
                    <c:out value="${totalUsers}" default="0"/>
                </div>
                <div class="stat-desc">
                    현재 도란도란에 가입한 전체 회원 수입니다.
                </div>
            </div>

            <!-- 오늘 가입한 회원 수 -->
            <div class="stat-card">
                <div class="stat-title">오늘 신규 가입</div>
                <div class="stat-value">
                    <c:out value="${todayNewUsers}" default="0"/>
                </div>
                <div class="stat-desc">
                    오늘 기준 신규 가입한 회원 수입니다.
                </div>
            </div>

            <!-- 전체 상품 수 -->
            <div class="stat-card">
                <div class="stat-title">등록된 상품 수</div>
                <div class="stat-value">
                    <c:out value="${totalItems}" default="0"/>
                </div>
                <div class="stat-desc">
                    판매/나눔을 위해 등록된 전체 상품 수입니다.
                </div>
            </div>

            <!-- 전체 거래 수 -->
            <div class="stat-card">
                <div class="stat-title">누적 거래 수</div>
                <div class="stat-value">
                    <c:out value="${totalTransactions}" default="0"/>
                </div>
                <div class="stat-desc">
                    완료된 거래(거래 내역 기준)의 누적 건수입니다.
                </div>
            </div>

            <!-- 미처리 신고 수 -->
            <div class="stat-card">
                <div class="stat-title">미처리 신고</div>
                <div class="stat-value">
                    <c:out value="${pendingReports}" default="0"/>
                </div>
                <div class="stat-desc">
                    아직 처리되지 않은 신고 건수입니다.
                    <br>
                    <a href="${pageContext.request.contextPath}/admin/reports" style="font-size:12px; text-decoration: underline;">
                        신고 관리 바로 가기
                    </a>
                </div>
            </div>

        </div><!-- /.stats-grid -->

        <!-- 기본 통계 (기존 AdminStatsDTO) -->
        <c:if test="${not empty basicStats}">
            <div class="section-title">기본 통계 요약</div>
            <div class="section-sub">
                기존에 사용하던 통계 값 (총 회원 수 / 총 신고 수)을 함께 보여줍니다.
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-title">총 회원 수 (DTO)</div>
                    <div class="stat-value">
                        <c:out value="${basicStats.totalUsers}" default="0"/>
                    </div>
                    <div class="stat-desc">AdminStatsDTO 기반 값입니다.</div>
                </div>
                <div class="stat-card">
                    <div class="stat-title">총 신고 수</div>
                    <div class="stat-value">
                        <c:out value="${basicStats.totalReports}" default="0"/>
                    </div>
                    <div class="stat-desc">누적 신고 건수입니다.</div>
                </div>
            </div>
        </c:if>

        <!-- 최근 7일 회원 가입 추이 -->
        <div class="section-title">최근 7일 회원 가입 추이</div>
        <div class="section-sub">
            일자별 신규 가입 수를 기준으로 서비스 성장 속도를 확인할 수 있습니다.
        </div>

        <c:choose>
            <c:when test="${not empty signupStats}">
                <table class="stats-table">
                    <thead>
                    <tr>
                        <th>날짜</th>
                        <th>신규 가입 수</th>
                    </tr>
                    </thead>
                    <tbody>
                    <c:forEach var="s" items="${signupStats}">
                        <tr>
                            <!-- DailySignupDTO: date, count -->
                            <td><c:out value="${s.date}"/></td>
                            <td><c:out value="${s.count}"/></td>
                        </tr>
                    </c:forEach>
                    </tbody>
                </table>
            </c:when>
            <c:otherwise>
                <p style="font-size:13px; color:#6b7280;">최근 7일 간 가입 데이터가 없습니다.</p>
            </c:otherwise>
        </c:choose>

        <!-- 신고 상태별 현황 -->
        <div class="section-title">신고 상태별 현황</div>
        <div class="section-sub">
            PENDING / RESOLVED 등 상태별 신고 건수를 통해 현재 위험도를 파악할 수 있습니다.
        </div>

        <c:choose>
            <c:when test="${not empty reportStats}">
                <table class="stats-table">
                    <thead>
                    <tr>
                        <th>상태</th>
                        <th>건수</th>
                    </tr>
                    </thead>
                    <tbody>
                    <c:forEach var="r" items="${reportStats}">
                        <tr>
                            <td>
                                <c:choose>
                                    <c:when test="${r.status == 'PENDING'}">
                                        <span class="badge badge-pending">PENDING</span>
                                    </c:when>
                                    <c:when test="${r.status == 'RESOLVED'}">
                                        <span class="badge badge-resolved">RESOLVED</span>
                                    </c:when>
                                    <c:otherwise>
                                        <span class="badge">${r.status}</span>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                            <td><c:out value="${r.count}"/></td>
                        </tr>
                    </c:forEach>
                    </tbody>
                </table>
            </c:when>
            <c:otherwise>
                <p style="font-size:13px; color:#6b7280;">신고 데이터가 없습니다.</p>
            </c:otherwise>
        </c:choose>

        <!-- 신뢰도 상위 회원 TOP 5 -->
        <div class="section-title">신뢰도 상위 회원 TOP 5</div>
        <div class="section-sub">
            거래 평가 등을 기준으로 높은 신뢰도를 가진 회원 목록입니다.
        </div>

        <c:choose>
            <c:when test="${not empty topUsers}">
                <table class="stats-table">
                    <thead>
                    <tr>
                        <th>순위</th>
                        <th>회원 ID</th>
                        <th>닉네임</th>
                        <th>신뢰도 점수</th>
                        <th>가입일</th>
                    </tr>
                    </thead>
                    <tbody>
                    <c:forEach var="u" items="${topUsers}" varStatus="st">
                        <tr>
                            <td>${st.index + 1}</td>
                            <!-- UserTrustRankDTO: userId, nickname, trustScore, createdAt -->
                            <td><c:out value="${u.userId}"/></td>
                            <td><c:out value="${u.nickname}"/></td>
                            <td><c:out value="${u.trustScore}"/></td>
                            <td><c:out value="${u.createdAt}"/></td>
                        </tr>
                    </c:forEach>
                    </tbody>
                </table>
            </c:when>
            <c:otherwise>
                <p style="font-size:13px; color:#6b7280;">신뢰도 랭킹 데이터가 없습니다.</p>
            </c:otherwise>
        </c:choose>

    </section>

</div><!-- /.admin-container -->

</body>
</html>
