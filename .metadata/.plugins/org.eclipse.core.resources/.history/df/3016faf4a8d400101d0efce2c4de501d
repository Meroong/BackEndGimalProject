<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>모임 상세 - 관리자</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin.css">
    <style>
        .detail-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 12px 0;
        }
        .detail-label {
            width: 80px;
            font-weight: 600;
            color: #4b5563;
        }
        .status-select {
            min-width: 200px;
            padding: 8px 10px;
            border-radius: 999px;
            border: 1px solid #d1d5db;
            font-size: 14px;
        }
        .status-current {
            font-weight: 700;
            color: #1f2937;
            margin-right: 10px;
        }
    </style>
</head>
<body class="admin-body">

<div class="admin-container">

    <!-- 헤더 -->
    <header>
        <h1>모임 상세</h1>

        <div class="header-buttons">
            <button class="log-btn"
                    onclick="location.href='${pageContext.request.contextPath}/admin/meeting/list'">
                목록으로
            </button>
        </div>
    </header>

    <section class="main-box">
        <div class="box-title">모임 정보</div>
        <p>모임 상태를 포함한 기본 정보를 확인하고, 필요 시 상태를 변경할 수 있습니다.</p>

        <!-- 모임 기본 정보 (필요하면 여기 안에 제목/설명 등 추가해서 쓰면 됨) -->
        <div class="detail-row">
            <div class="detail-label">번호</div>
            <div>#<c:out value="${meeting.id}" /></div>
        </div>

        <!-- 🔥 상태 변경 영역 (핵심) -->
        <div class="detail-row">
            <div class="detail-label">상태</div>

            <!-- 현재 상태 표시 -->
            <span class="status-current">
                현재 상태:
                <c:out value="${meeting.status}" />
            </span>

            <!-- 상태 변경 폼 -->
            <form method="post"
                  action="${pageContext.request.contextPath}/admin/meeting/status"
                  style="display: inline-flex; align-items: center; gap: 8px;">

                <!-- 어떤 모임인지 넘겨주기 -->
                <input type="hidden" name="id" value="${meeting.id}" />

                <!-- 변경할 상태 선택 -->
                <select name="status" class="status-select">
                    <option value="OPEN"
                        <c:if test="${meeting.status == 'OPEN'}">selected</c:if>>
                        OPEN (모집중)
                    </option>
                    <option value="CLOSED"
                        <c:if test="${meeting.status == 'CLOSED'}">selected</c:if>>
                        CLOSED (모집 마감)
                    </option>
                    <option value="COMPLETED"
                        <c:if test="${meeting.status == 'COMPLETED'}">selected</c:if>>
                        COMPLETED (모임 종료)
                    </option>
                </select>

                <button type="submit" class="log-btn">
                    상태 변경
                </button>
            </form>
        </div>

        <hr style="margin: 24px 0; border: none; border-top: 1px solid #e5e7eb;">

        <p style="font-size:13px; color:#6b7280;">
            상태 변경 후에는 즉시 DB에 반영되며, 모임 목록에도 같은 상태로 표시됩니다.
        </p>
    </section>

</div>

</body>
</html>
